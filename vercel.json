{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "framework": "nuxtjs",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.viewora.software"
        }
      ],
      "destination": "https://viewora.software/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "www.viewora.software"
        }
      ],
      "destination": "https://viewora.software/:path*",
      "permanent": true
    },
    {
      "source": "/p/:slug",
      "destination": "https://app.viewora.software/p/:slug",
      "permanent": true
    },
    {
      "source": "/embed/:slug",
      "destination": "https://app.viewora.software/embed/:slug",
      "permanent": true
    }
  ]
}
